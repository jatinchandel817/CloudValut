# ============================================================
#  Environment variables for docker-compose
#  Copy this file to .env and fill in your values.
#  ============================================================

# Database
DB_PASSWORD=changeme

# Storage providers to enable (comma-separated: LOCAL, S3, GCS)
STORAGE_ENABLED_PROVIDERS=LOCAL

# AWS S3
AWS_REGION=
AWS_S3_BUCKET=

# Google Cloud Storage
GCP_PROJECT_ID=
GCP_BUCKET_NAME=
